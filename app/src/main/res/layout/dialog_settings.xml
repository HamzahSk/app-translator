<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/settingsDialogRoot" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/tvSettingsTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" android:textStyle="bold" />
            <ImageButton android:id="@+id/btnSettingsClose" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </LinearLayout>
        <TextView android:id="@+id/tvSettingsDelay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
        <com.google.android.material.slider.Slider android:id="@+id/sliderSettingsDelay" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0.5" android:valueTo="10.0" android:stepSize="0.5" />
        <TextView android:id="@+id/tvSettingsOpacity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
        <com.google.android.material.slider.Slider android:id="@+id/sliderSettingsOpacity" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="50" android:valueTo="100" android:stepSize="5" />
        <TextView android:id="@+id/tvSettingsCorner" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
        <com.google.android.material.slider.Slider android:id="@+id/sliderSettingsCorner" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0" android:valueTo="32" android:stepSize="1" />
        <TextView android:id="@+id/tvSettingsTextSize" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
        <com.google.android.material.slider.Slider android:id="@+id/sliderSettingsTextSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="8" android:valueTo="28" android:stepSize="1" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/settingsAutoTextFit" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/settingsAutoRotate" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/settingsTransparentMode" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:id="@+id/layoutOutlineConfig" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/tvSettingsOutlineThickness" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
            <com.google.android.material.slider.Slider android:id="@+id/sliderSettingsOutlineThickness" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="1" android:valueTo="10" />
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Outline Color (#RRGGBB)">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputSettingsOutlineColor" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLength="9" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/settingsEraserMode" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="App Language">
            <AutoCompleteTextView android:id="@+id/spinnerAppLanguage" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/tvSettingsMergeVertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
        <com.google.android.material.slider.Slider android:id="@+id/sliderSettingsMergeVertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0.5" android:valueTo="3" />
        <TextView android:id="@+id/tvSettingsMergeHorizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
        <com.google.android.material.slider.Slider android:id="@+id/sliderSettingsMergeHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0" android:valueTo="0.8" />
        <TextView android:id="@+id/tvSettingsMergeSize" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
        <com.google.android.material.slider.Slider android:id="@+id/sliderSettingsMergeSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0" android:valueTo="1" />
        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/settingsPlacement" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:singleSelection="true" app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/settingsDirect" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <com.google.android.material.button.MaterialButton android:id="@+id/settingsLeft" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <com.google.android.material.button.MaterialButton android:id="@+id/settingsRight" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/settingsBorder" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tvSettingsAutoClear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <com.google.android.material.slider.Slider android:id="@+id/sliderSettingsAutoClear" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0" android:valueTo="30" android:stepSize="1" />
        <TextView android:id="@+id/tvSettingsBallSize" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <com.google.android.material.slider.Slider android:id="@+id/sliderSettingsBall" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="28" android:valueTo="72" android:stepSize="1" />
    </LinearLayout>
</ScrollView>
